diff --git a/turtlebot_ddpg/scripts/voronoi_exploration/waypoint_visibility.py b/turtlebot_ddpg/scripts/voronoi_exploration/waypoint_visibility.py
new file mode 100644
index 0000000..5d4ca07
--- /dev/null
+++ b/turtlebot_ddpg/scripts/voronoi_exploration/waypoint_visibility.py
@@ -0,0 +1,39 @@
+"""Keep lookahead commands from cutting through occupied scan-map cells."""
+
+import math
+
+import numpy as np
+
+from scan_mapping import bresenham_cells
+
+
+WAYPOINT_VISIBILITY_MODES = ('off', 'observe', 'shorten')
+
+
+def waypoint_ray_blocked(grid, start, end):
+    """Ignore the robot's own cell and test the remaining rasterised ray."""
+    return any(grid[y, x] == 2 for x, y in bresenham_cells(start, end)[1:])
+
+
+def visible_lookahead(grid, pos, path, requested, cell_index, lookahead):
+    """Return the requested point or the farthest visible preceding path point."""
+    start = cell_index(*pos)
+    if not waypoint_ray_blocked(grid, start, cell_index(*requested)):
+        return requested
+    if not path:
+        return None
+
+    nearest = int(np.argmin(np.linalg.norm(np.asarray(path) - pos, axis=1)))
+    travelled = 0.0
+    candidates = []
+    for before, after in zip(path[nearest:], path[nearest + 1:]):
+        travelled += math.dist(before, after)
+        if travelled > lookahead:
+            break
+        candidates.append(after)
+
+    for point in reversed(candidates):
+        cell = cell_index(*point)
+        if cell != start and not waypoint_ray_blocked(grid, start, cell):
+            return np.asarray(point)
+    return None
diff --git a/turtlebot_ddpg/tests/test_waypoint_visibility.py b/turtlebot_ddpg/tests/test_waypoint_visibility.py
new file mode 100644
index 0000000..1b7415d
--- /dev/null
+++ b/turtlebot_ddpg/tests/test_waypoint_visibility.py
@@ -0,0 +1,72 @@
+"""Check scan-visible lookahead and retirement of obstructed commands."""
+
+from pathlib import Path
+import sys
+import unittest
+from unittest.mock import Mock
+
+import numpy as np
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'scripts/voronoi_exploration'))
+from exploration_coordinator import Coordinator, POLICY_IDLE_Z
+from waypoint_visibility import visible_lookahead, waypoint_ray_blocked
+
+
+class WaypointVisibilityTests(unittest.TestCase):
+    def test_shortens_to_farther_clear_path_cell_around_corner(self):
+        grid = np.ones((4, 4), dtype=np.uint8)
+        grid[1, 1] = 2
+        path = [(0, 0), (0, 1), (0, 2), (1, 2), (2, 2)]
+        locate = lambda x, y: (int(x), int(y))
+        pos = np.array([0.0, 0.0])
+        original = np.array([2.0, 2.0])
+        selected = visible_lookahead(grid, pos, path, original, locate, 4.0)
+        self.assertTrue(waypoint_ray_blocked(grid, (0, 0), (2, 2)))
+        np.testing.assert_array_equal(selected, [0, 2])
+        self.assertEqual(grid[1, 1], 2)
+
+    def test_preserves_unobstructed_target_and_suppresses_blocked_beeline(self):
+        grid = np.zeros((3, 3), dtype=np.uint8)
+        grid[0, 0] = 2
+        locate = lambda x, y: (int(x), int(y))
+        pos, target = np.array([0, 0]), np.array([2, 2])
+        self.assertIs(visible_lookahead(grid, pos, None, target, locate, 3.0), target)
+        grid[1, 1] = 2
+        self.assertIsNone(visible_lookahead(grid, pos, None, target, locate, 3.0))
+
+    def check_blocked_command_retirement(self, depth_active):
+        coord = Coordinator.__new__(Coordinator)
+        name = 'robot1'
+        coord.waypoint_visibility_mode = 'shorten'
+        coord.frontier_trace = None
+        coord.grid = np.zeros((3, 3), dtype=np.uint8)
+        coord.grid[0, 1] = 2
+        coord._cell_index = lambda x, y: (int(x), int(y))
+        coord.current_goal = {name: (2.0, 0.0)}
+        coord.current_goal_id = {name: 9}
+        coord.current_path = {name: None}
+        coord.policy_waypoints = {name}
+        coord.positions = {name: (0.0, 0.0)}
+        coord.targets_pub = {name: Mock()}
+        coord.passage_continuations = {}
+        coord.depth_active = depth_active
+        if depth_active:
+            coord.depth_commanded_waypoints = {name: np.array([2.0, 0.0])}
+        coord.goals_dropped_blocked = 0
+        coord._finish_frontier_attempt = Mock()
+        coord._publish_navigation_waypoint(name, np.array([0.0, 0.0]),
+                                           coord.current_goal[name], None)
+        coord._finish_frontier_attempt.assert_called_once_with(name, 'blocked')
+        self.assertIsNone(coord.current_goal[name])
+        self.assertIsNone(coord.current_goal_id[name])
+        if depth_active:
+            self.assertNotIn(name, coord.depth_commanded_waypoints)
+        self.assertNotIn(name, coord.policy_waypoints)
+        self.assertEqual(coord.targets_pub[name].publish.call_args.args[0].z, POLICY_IDLE_Z)
+        self.assertEqual(coord.goals_dropped_blocked, 1)
+
+    def test_blocked_command_retires_waypoint_with_depth_on(self):
+        self.check_blocked_command_retirement(depth_active=True)
+
+    def test_blocked_command_retires_waypoint_with_depth_off(self):
+        self.check_blocked_command_retirement(depth_active=False)
