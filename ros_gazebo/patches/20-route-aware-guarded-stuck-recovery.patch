@@ -0,0 +1,88 @@
+"""Temporary failure memory and scan-guarded recovery for exploration routes."""
+
+import math
+
+import numpy as np
+
+
+TARGET_COOLDOWN_S = 20.0
+FAILED_TARGET_RADIUS_M = 0.75
+FAILED_ROUTE_RADIUS_M = 0.65
+FAILED_ROUTE_EXTRA_COST = 3.0
+GUARDED_RECOVERY_DURATION_S = 2.50
+RECOVERY_PAUSE_S = GUARDED_RECOVERY_DURATION_S + 0.25
+RECOVERY_TURN_MIN_S = 0.65
+RECOVERY_HEADING_MIN_RAD = 0.35
+MAX_RECOVERY_SCAN_AGE_S = 0.40
+
+
+class RouteFailureMemory:
+    """Keep per-robot failed targets and route locations outside the occupancy map."""
+
+    def __init__(self):
+        self._entries = {}
+
+    def _active(self, robot, now):
+        entries = [entry for entry in self._entries.get(robot, ()) if entry[2] > now]
+        self._entries[robot] = entries
+        return entries
+
+    def record(self, robot, position, target, now):
+        position = tuple(position)
+        target = None if target is None else tuple(target)
+        entries = self._active(robot, now)
+        entries.append((position, target, now + TARGET_COOLDOWN_S))
+
+    def available(self, robot, target, now):
+        return not any(goal is not None and math.dist(target, goal) <= FAILED_TARGET_RADIUS_M
+                       for _, goal, _ in self._active(robot, now))
+
+    def penalties(self, robot, xs, ys, now):
+        entries = self._active(robot, now)
+        if not entries:
+            return None
+        cost = np.zeros((len(ys), len(xs)), dtype=float)
+        for (x, y), _, _ in entries:
+            near = (xs[None, :] - x) ** 2 + (ys[:, None] - y) ** 2 <= FAILED_ROUTE_RADIUS_M ** 2
+            cost[near] = FAILED_ROUTE_EXTRA_COST
+        return cost
+
+
+def available_owner(owner, costs, available):
+    """Transfer an unavailable frontier to the lowest-cost eligible teammate."""
+    owner = np.asarray(owner).copy()
+    for index, robot in enumerate(owner):
+        if available[robot, index]:
+            continue
+        candidates = np.flatnonzero(available[:, index])
+        if len(candidates):
+            owner[index] = candidates[np.argmin(costs[candidates, index])]
+    return owner
+
+
+def guarded_recovery_command(ranges, angle_min, angle_increment, range_max,
+                             scan_age_s, elapsed_s, heading_change, turn_direction,
+                             stop_range, slow_range):
+    """Turn before moving through a fresh, clear forward sector."""
+    if (not 0 <= scan_age_s <= MAX_RECOVERY_SCAN_AGE_S
+            or angle_increment <= 0 or range_max <= 0):
+        return 0.0, 0.0, None, None, 'stale'
+    values = np.asarray(ranges, dtype=float)
+    if values.ndim != 1 or not values.size:
+        return 0.0, 0.0, None, None, 'stale'
+    values = np.clip(np.nan_to_num(values, nan=0.0, posinf=range_max, neginf=0.0), 0, range_max)
+    angles = angle_min + np.arange(values.size) * angle_increment
+
+    def sector(center, half_width):
+        relative = (angles - center + math.pi) % (2.0 * math.pi) - math.pi
+        samples = values[np.abs(relative) <= half_width + 1e-9]
+        return float(samples.min()) if samples.size else 0.0
+
+    front = sector(0.0, math.pi / 6)
+    side = sector(turn_direction * math.pi / 3, math.pi / 6)
+    if (elapsed_s >= RECOVERY_TURN_MIN_S and heading_change >= RECOVERY_HEADING_MIN_RAD
+            and front > stop_range):
+        speed_scale = min(1.0, (front - stop_range) / (slow_range - stop_range))
+        return 0.15 * speed_scale, 0.0, front, side, 'escape'
+    turn_scale = min(1.0, max(0.0, (side - stop_range) / (slow_range - stop_range)))
+    return 0.0, 0.8 * turn_direction * turn_scale, front, side, 'turn'
