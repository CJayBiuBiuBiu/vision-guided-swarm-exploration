+"""Regression checks for route retirement, temporary failure memory and recovery."""
+
+import math
+from pathlib import Path
+from queue import SimpleQueue
+import sys
+import unittest
+from unittest.mock import Mock
+
+import numpy as np
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'scripts/voronoi_exploration'))
+from exploration_coordinator import Coordinator, astar_grid
+from recovery_memory import TimedSpatialBlacklist
+from route_recovery import (
+    RECOVERY_PAUSE_S, TARGET_COOLDOWN_S, RouteFailureMemory, available_owner,
+    guarded_recovery_command)
+
+
+class RouteRecoveryTests(unittest.TestCase):
+    def test_memory_is_per_robot_and_expires(self):
+        memory = RouteFailureMemory()
+        memory.record('robot1', (0, 0), (2, 1), 1.0)
+        self.assertFalse(memory.available('robot1', (2.4, 1), 2.0))
+        self.assertTrue(memory.available('robot2', (2.4, 1), 2.0))
+        self.assertTrue(memory.available('robot1', (3, 1), 2.0))
+        self.assertTrue(memory.available('robot1', (2, 1), 1.0 + TARGET_COOLDOWN_S))
+
+    def test_route_penalty_detours_without_changing_occupancy(self):
+        grid = np.ones((11, 11), dtype=np.uint8)
+        axis = np.arange(11) * 0.2
+        memory = RouteFailureMemory()
+        memory.record('robot1', (1, 1), (1.8, 1), 0.0)
+        costs = memory.penalties('robot1', axis, axis, 1.0)
+        direct = astar_grid(grid, (0, 5), (10, 5))
+        detour = astar_grid(grid, (0, 5), (10, 5), cell_penalty=costs)
+        self.assertIn((5, 5), direct)
+        self.assertNotIn((5, 5), detour)
+        self.assertEqual(sum(costs[y, x] for x, y in detour), 0)
+        self.assertTrue((grid == 1).all())
+        self.assertIsNone(memory.penalties('robot2', axis, axis, 1.0))
+        self.assertIsNone(memory.penalties('robot1', axis, axis, TARGET_COOLDOWN_S))
+
+    def test_owner_transfer_and_all_masked_case(self):
+        owner = [0, 1, 0]
+        costs = np.array([[1, 5, 0], [7, 1, 2], [3, 2, 4]])
+        eligible = np.array([[False, True, False], [True, True, False],
+                             [True, True, False]])
+        np.testing.assert_array_equal(available_owner(owner, costs, eligible), [2, 1, 0])
+
+    def command(self, scan, age=0.1, elapsed=1.0, heading=0.6):
+        return guarded_recovery_command(scan, -1.5707, 2 * 1.5707 / 23, 3.5,
+                                       age, elapsed, heading, 1.0, 0.20, 0.35)
+
+    def test_front_only_recovery_turns_then_translates(self):
+        ranges = np.ones(24)
+        self.assertEqual(self.command(ranges, elapsed=0.2)[:2], (0.0, 0.8))
+        self.assertEqual(self.command(ranges, heading=0.2)[:2], (0.0, 0.8))
+        self.assertEqual(self.command(ranges)[:2], (0.15, 0.0))
+        self.assertEqual(self.command(ranges, age=0.41)[:2], (0, 0))
+
+    def test_recovery_speed_scales_and_unknown_is_not_clear(self):
+        ranges = np.ones(24)
+        ranges[12] = 0.275
+        self.assertAlmostEqual(self.command(ranges)[0], 0.075)
+        ranges[12] = np.nan
+        self.assertEqual(self.command(ranges)[:2], (0.0, 0.8))
+        ranges[-1] = 0.15
+        self.assertEqual(self.command(ranges)[:2], (0.0, 0.0))
+        ranges[12] = float('inf')
+        self.assertEqual(self.command(ranges)[:2], (0.15, 0.0))
+
+    def test_reporter_far_goal_is_retired_without_retiring_far_teammate(self):
+        coord = Coordinator.__new__(Coordinator)
+        coord.robot_names = ['robot1', 'robot2']
+        coord.route_recovery_events = SimpleQueue()
+        coord.route_recovery_events.put(('robot1', (0.0, 0.0), 4.9))
+        coord.current_goal = {'robot1': (3.0, 0.0), 'robot2': (3.0, 1.0)}
+        coord.current_goal_id = {'robot1': 12, 'robot2': 14}
+        coord.current_path = {'robot1': [(0.0, 0.0), (3.0, 0.0)], 'robot2': [(3, 1)]}
+        coord.stuck_events = {'robot1': 0, 'robot2': 0}
+        coord.route_failures = RouteFailureMemory()
+        coord.route_pause_until = {}
+        coord.last_consumed_policy_action = {'robot1': 4.0, 'robot2': 4.0}
+        coord.passage_continuations = {'robot1': {}}
+        coord.passage_inspections = {}
+        coord.blacklist = TimedSpatialBlacklist()
+        coord.unique_stuck_regions = 0
+        coord._control_now = Mock(return_value=5.0)
+        coord._frontier_trace_snapshot = Mock(return_value=(4.9, 2.0))
+        coord.frontier_trace = Mock()
+        coord._finish_frontier_attempt = Mock()
+        coord._retire_policy_waypoint = Mock()
+        coord._drain_route_recovery_events()
+        self.assertIsNone(coord.current_goal['robot1'])
+        self.assertIsNone(coord.current_path['robot1'])
+        self.assertEqual(coord.current_goal['robot2'], (3.0, 1.0))
+        self.assertFalse(coord.route_failures.available('robot1', (3.0, 0.0), 6.0))
+        self.assertEqual(coord.route_pause_until['robot1'], 5.0 + RECOVERY_PAUSE_S)
+        self.assertEqual(coord.last_consumed_policy_action['robot1'], 5.0 + RECOVERY_PAUSE_S)
+        coord._finish_frontier_attempt.assert_called_once_with('robot1', 'stuck')
+        coord._retire_policy_waypoint.assert_called_once_with('robot1')
+        self.assertEqual(coord.frontier_trace.record.call_args.kwargs['goal_distance_m'], 3.0)
+
+
+if __name__ == '__main__':
+    unittest.main()
