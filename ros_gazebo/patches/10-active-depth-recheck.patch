+
+class ActiveDepthTests(unittest.TestCase):
+    def setUp(self):
+        from depth_corridor import ActiveDepthConfirmation
+        self.tracker = ActiveDepthConfirmation()
+        self.hit = {"xy": [0.8, 0.1]}
+
+    def test_distinct_frames_confirm_once_until_clear(self):
+        check = self.tracker.observe
+        self.assertFalse(check(1.0, self.hit)["confirmed"])
+        self.assertIsNone(check(1.0, self.hit))
+        self.assertTrue(check(1.25, self.hit)["confirmed"])
+        self.assertFalse(check(1.5, self.hit)["confirmed"])
+        check(1.75, None)
+        self.assertFalse(check(2.0, self.hit)["confirmed"])
+        self.assertTrue(check(2.25, self.hit)["confirmed"])
+
+    def test_late_or_spatially_distinct_hits_do_not_confirm(self):
+        check = self.tracker.observe
+        check(1.0, self.hit)
+        self.assertFalse(check(1.75, self.hit)["confirmed"])
+        self.assertFalse(check(2.0, {"xy": [1.3, 0.0]})["confirmed"])
+        self.tracker.reset()
+        self.assertFalse(check(2.25, self.hit)["confirmed"])
+
+    def test_interrupted_goal_and_shifted_frontier_expire(self):
+        from depth_corridor import reroute_exclusions
+        frontiers = np.array([[0, 0], [1.5, 0], [1.2, 0]])
+        pending = {"stamp": 4.0, "frontier_id": 4, "goal_xy": [1, 0]}
+        np.testing.assert_equal(reroute_exclusions(frontiers, [4, 5, 6], pending, 5.0),
+                                [True, False, True])
+        np.testing.assert_equal(reroute_exclusions(frontiers, [4, 5, 6], pending, 7.0),
+                                [False, False, False])
