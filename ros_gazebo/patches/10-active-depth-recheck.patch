     return dict(xy=points[first].tolist(), along_m=float(projection[first]),
                 support=int(len(indices)))
+
+
+ACTIVE_CONFIRM_INTERVAL_S = 0.50
+ACTIVE_CONFIRM_RADIUS_M = 0.28
+RECHECK_EXCLUSION_S = 3.0
+RECHECK_GOAL_RADIUS_M = 0.30
+
+
+class ActiveDepthConfirmation:
+    """Confirm a persistent hit with distinct frames on the same assignment."""
+
+    def __init__(self):
+        self.reset()
+
+    def reset(self):
+        self.last_stamp = -np.inf
+        self.previous_hit = None
+        self.reported = False
+
+    def observe(self, stamp, hit):
+        if stamp <= self.last_stamp:
+            return None
+        self.last_stamp = stamp
+        previous = self.previous_hit
+        if hit is None:
+            self.previous_hit = None
+            self.reported = False
+            return {"confirmed": False, "previous_stamp": None, "previous_xy": None}
+        agrees = (previous is not None and stamp - previous[0] <= ACTIVE_CONFIRM_INTERVAL_S
+                  and np.linalg.norm(np.subtract(hit["xy"], previous[1])) <= ACTIVE_CONFIRM_RADIUS_M)
+        self.previous_hit = (stamp, hit["xy"])
+        checked = bool(agrees and not self.reported)
+        self.reported = bool(agrees)
+        return {"confirmed": checked, "previous_stamp": previous[0] if agrees else None,
+                "previous_xy": previous[1] if agrees else None}
+
+
+def reroute_exclusions(frontiers, frontier_ids, interruption, now):
+    """Suppress the recently confirmed goal ID and its immediate vicinity."""
+    if now >= interruption["stamp"] + RECHECK_EXCLUSION_S:
+        return np.zeros(len(frontiers), dtype=bool)
+    return ((np.asarray(frontier_ids) == interruption["frontier_id"])
+            | (np.linalg.norm(frontiers - interruption["goal_xy"], axis=1)
+               <= RECHECK_GOAL_RADIUS_M))
