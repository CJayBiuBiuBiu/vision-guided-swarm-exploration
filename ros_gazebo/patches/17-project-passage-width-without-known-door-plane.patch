+def reference_obstacles(path, arena):
+    """Read a scoring mask geometry independent of the live navigation map."""
+    with open(path, encoding="utf-8") as stream:
+        data = json.load(stream)
+    if list(arena) != data["arena"]:
+        raise ValueError("Evaluation mask must use the configured arena bounds")
+    obstacles = []
+    x_min, y_min, x_max, y_max = arena
+    for box_values in data["obstacles"]:
+        x0, y0, x1, y1 = map(float, box_values)
+        if (not all(map(math.isfinite, (x0, y0, x1, y1)))
+                or not x_min <= x0 < x1 <= x_max or not y_min <= y0 < y1 <= y_max):
+            raise ValueError("Evaluation obstacles must lie within the arena")
+        obstacles.append((x0, y0, x1, y1))
+    return obstacles
