+def centre_width(supported):
+    """Count contiguous supported samples on both sides of the corridor centre."""
+    midpoint = supported.shape[-1] // 2
+    left = np.logical_and.accumulate(supported[..., midpoint::-1], axis=-1).sum(axis=-1)
+    right = np.logical_and.accumulate(supported[..., midpoint:], axis=-1).sum(axis=-1)
+    return np.maximum(0, left + right - 1) * WIDTH_STEP_M
+
+
+def visible_corridor_width(supported, visible):
+    """Require the robot envelope in frame, allowing unneeded outer samples to crop."""
+    midpoint = supported.shape[-1] // 2
+    half_envelope = math.ceil(MIN_PASSAGE_WIDTH_M / (2 * WIDTH_STEP_M))
+    interior = slice(midpoint - half_envelope, midpoint + half_envelope + 1)
+    width = centre_width(supported & visible)
+    width[~visible[..., interior].all(axis=-1)] = np.nan
+    return width
+
+
+def measure_projected_width(image, intrinsics, pose):
+    """Sample robot-centred cross-sections without a surveyed doorway plane."""
+    reference = floor_reference(image, intrinsics, pose)
+    if reference is None:
+        return None
+    color, yaw = reference
+    samples, valid, _ = floor_samples(
+        image, intrinsics, pose, BEARINGS_DEG, WIDTH_DISTANCES_M, WIDTH_OFFSETS_M)
+    error = np.linalg.norm(samples - color, axis=-1)
+    supported = np.clip((48.0 - error) / 28.0, 0, 1) >= 0.80
+    return yaw, visible_corridor_width(supported, valid)
+
+
+def projected_width_score(sample, target_xy):
+    position, yaw, widths = sample
+    bearing = bearing_sample(position, yaw, target_xy)
+    if bearing is None:
+        return None
+    index, angle = bearing
+    section = widths[index]
+    visible = np.flatnonzero(np.isfinite(section))
+    if not len(visible) or WIDTH_DISTANCES_M[visible[0]] > MAX_WIDTH_START_M:
+        return None
+    start = int(visible[0])
+    missing = np.flatnonzero(~np.isfinite(section[start:]))
+    last = start + int(missing[0]) if len(missing) else len(section)
+    if last - start < 2:
+        return None
+    narrow = section[start:last] < MIN_PASSAGE_WIDTH_M
+    bottlenecks = np.flatnonzero(narrow[:-1] & narrow[1:])
+    blocked = start + int(bottlenecks[0]) if len(bottlenecks) else None
+    clear_to = float(WIDTH_DISTANCES_M[last - 1] if blocked is None
+                     else WIDTH_DISTANCES_M[blocked] - 0.25)
+    return dict(bearing_deg=angle, clear_to_m=clear_to,
+                starts_m=float(WIDTH_DISTANCES_M[start]),
+                bottleneck_m=None if blocked is None else float(WIDTH_DISTANCES_M[blocked]),
+                bottleneck_width_m=None if blocked is None else float(section[blocked]))
+
+
+def paired_width_score(samples, target_xy):
+    """Keep camera evidence that agrees across two independent frames."""
+    a, b = (projected_width_score(sample, target_xy) for sample in samples)
+    if a is None or b is None:
+        return None
+    first, second = a['bottleneck_m'], b['bottleneck_m']
+    if (first is None) != (second is None):
+        return None
+    if first is not None and abs(first - second) > 0.50:
+        return None
+    return dict(bottleneck_m=second, bottleneck_width_m=b['bottleneck_width_m'],
+                clear_to_m=min(a['clear_to_m'], b['clear_to_m']),
+                starts_m=max(a['starts_m'], b['starts_m']))
+
+
+def width_alternative(preferred_score, score):
+    return (preferred_score is not None and preferred_score['bottleneck_m'] is not None
+            and score is not None
+            and score['clear_to_m'] >= preferred_score['clear_to_m'] + MIN_CLEAR_GAIN_M)
+
