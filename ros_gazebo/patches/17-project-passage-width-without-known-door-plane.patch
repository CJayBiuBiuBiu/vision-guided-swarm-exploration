+import json
+from pathlib import Path
+import sys
+import tempfile
+import unittest
+
+import numpy as np
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'scripts/voronoi_exploration'))
+from passage_scene import ARENA, reference_obstacles
+from rgb_passage import (
+    BEARINGS_DEG, WIDTH_DISTANCES_M, centre_width, paired_width_score,
+    projected_width_score, visible_corridor_width, width_alternative,
+)
+
+
+class ProjectedPassageWidthTests(unittest.TestCase):
+    def test_uses_contiguous_floor_containing_the_centre(self):
+        widths = centre_width(np.array([[1, 0, 1, 1, 0, 1, 1],
+                                        [1, 1, 1, 0, 1, 1, 1]], dtype=bool))
+        np.testing.assert_allclose(widths, [0.10, 0.0])
+
+    def test_two_depth_slices_define_a_bottleneck(self):
+        widths = np.ones((len(BEARINGS_DEG), len(WIDTH_DISTANCES_M)))
+        widths[:, 4] = 0.25
+        sample = (np.zeros(3), 0.0, widths)
+        self.assertIsNone(projected_width_score(sample, (3, 0))['bottleneck_m'])
+        widths[:, 5] = 0.25
+        score = paired_width_score((sample, sample), (3, 0))
+        self.assertEqual(score['bottleneck_m'], 2.0)
+        opened = (np.zeros(3), 0.0, np.ones_like(widths))
+        self.assertIsNone(paired_width_score((sample, opened), (3, 0)))
+        self.assertTrue(width_alternative(score, paired_width_score((opened, opened), (3, 0))))
+        opened[2][:, 10:12] = 0.25
+        later_bottleneck = paired_width_score((opened, opened), (3, 0))
+        self.assertEqual(later_bottleneck['bottleneck_m'], 3.5)
+        self.assertTrue(width_alternative(score, later_bottleneck))
+        widths[:, :1] = np.nan
+        self.assertEqual(projected_width_score(sample, (3, 0))['starts_m'], 1.25)
+        widths[:, :4] = np.nan
+        self.assertIsNone(projected_width_score(sample, (3, 0)))
+
+    def test_crop_of_outer_columns_leaves_the_robot_envelope_valid(self):
+        supported = np.ones((2, 21), dtype=bool)
+        visible = supported.copy()
+        visible[:, :3] = False
+        visible[1, 6] = False
+        result = visible_corridor_width(supported, visible)
+        self.assertAlmostEqual(result[0], 0.90)
+        self.assertTrue(np.isnan(result[1]))
+
+    def test_reference_geometry_is_bounded(self):
+        with tempfile.TemporaryDirectory() as directory:
+            file = Path(directory) / 'ref.json'
+            file.write_text(json.dumps(dict(arena=ARENA, obstacles=[(-1, 0, 0, 1)])))
+            self.assertEqual(reference_obstacles(file, ARENA), [(-1, 0, 0, 1)])
+            file.write_text(json.dumps(dict(arena=ARENA, obstacles=[(-9, 0, 0, 1)])))
+            with self.assertRaises(ValueError):
+                reference_obstacles(file, ARENA)
