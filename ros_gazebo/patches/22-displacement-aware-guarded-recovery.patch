-RECOVERY_PAUSE_S = GUARDED_RECOVERY_DURATION_S + 0.25
+RECOVERY_RELEASE_DELAY_S = 0.25
+RECOVERY_PAUSE_S = GUARDED_RECOVERY_DURATION_S + RECOVERY_RELEASE_DELAY_S
+EXTENDED_RECOVERY_DURATION_S = 6.25
+EXTENDED_RECOVERY_PAUSE_S = EXTENDED_RECOVERY_DURATION_S + RECOVERY_RELEASE_DELAY_S
+MIN_RECOVERY_PROGRESS_M = 0.12
