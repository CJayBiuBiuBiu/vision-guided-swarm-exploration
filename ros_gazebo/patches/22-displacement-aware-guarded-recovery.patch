 RECOVERY_TURN_MIN_S = 0.65
 RECOVERY_HEADING_MIN_RAD = 0.35
 MAX_RECOVERY_SCAN_AGE_S = 0.40


+def displacement_recovery_stop(elapsed_s, displacement_m):
+    """Continue beyond the fixed window only if the robot has made progress."""
+    if displacement_m >= FAILED_ROUTE_RADIUS_M:
+        return 'cleared_region'
+    if elapsed_s >= EXTENDED_RECOVERY_DURATION_S:
+        return 'time_limit'
+    if elapsed_s >= GUARDED_RECOVERY_DURATION_S and displacement_m < MIN_RECOVERY_PROGRESS_M:
+        return 'insufficient_progress'
+    return None
+
+
 class RouteFailureMemory:
     """Keep per-robot failed targets and route locations outside the occupancy map."""

