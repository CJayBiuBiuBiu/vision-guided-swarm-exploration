--- /dev/null
+++ b/turtlebot_ddpg/scripts/voronoi_exploration/camera_quality.py
@@ -0,0 +1,53 @@
+"""Measure camera quality at the encoder input scale."""
+
+import json
+import math
+from pathlib import Path
+
+import cv2
+import numpy as np
+
+
+CAMERA_PROFILES = ('clean', 'dark', 'blur')
+
+
+def camera_input(image, profile):
+    """Apply a reproducible stress condition before scoring."""
+    if profile == 'clean':
+        return image
+    if profile == 'dark':
+        return (image.astype(np.float32) * 0.28).astype(np.uint8)
+    if profile == 'blur':
+        return cv2.GaussianBlur(image, (11, 11), 3.0)
+    raise ValueError('Unknown camera profile: %s' % profile)
+
+
+def camera_features(image):
+    reduced = cv2.resize(image, (160, 96), interpolation=cv2.INTER_AREA)
+    gray = cv2.cvtColor(reduced, cv2.COLOR_RGB2GRAY)
+    return float(gray.mean()), float(cv2.Laplacian(gray, cv2.CV_32F).var())
+
+
+class CameraQualityGate:
+    def __init__(self, minimum_luma, minimum_sharpness):
+        self.minimum_luma = float(minimum_luma)
+        self.minimum_sharpness = float(minimum_sharpness)
+        if not (0 <= self.minimum_luma <= 255 and
+                math.isfinite(self.minimum_sharpness) and self.minimum_sharpness >= 0):
+            raise ValueError('Invalid camera-quality thresholds')
+
+    @classmethod
+    def load(cls, path):
+        profile = json.loads(Path(path).read_text())
+        if profile['format_version'] != 1:
+            raise ValueError('Unsupported camera-quality profile')
+        return cls(**profile['thresholds'])
+
+    def reason(self, luma, sharpness):
+        if not (math.isfinite(luma) and math.isfinite(sharpness)):
+            return 'invalid'
+        if luma < self.minimum_luma:
+            return 'underexposed'
+        if sharpness < self.minimum_sharpness:
+            return 'low_detail'
+        return 'accepted'
