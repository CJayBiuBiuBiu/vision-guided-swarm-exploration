diff --git a/turtlebot_ddpg/tests/test_camera_quality.py b/turtlebot_ddpg/tests/test_camera_quality.py
new file mode 100644
index 0000000000000000000000000000000000000000..41538191d894fb73d8a1a595417e92c068767bfc
--- /dev/null
+++ b/turtlebot_ddpg/tests/test_camera_quality.py
@@ -0,0 +1,35 @@
+import os
+import sys
+import unittest
+
+import numpy as np
+
+
+sys.path.insert(0, os.path.join(
+    os.path.dirname(os.path.dirname(__file__)), 'scripts', 'voronoi_exploration'))
+
+from camera_quality import CameraQualityGate, camera_features, camera_input
+
+
+class CameraQualityTests(unittest.TestCase):
+    def test_stress_and_gate_use_the_same_features(self):
+        image = np.tile(np.array([208, 52, 208, 52], dtype=np.uint8), (96, 40))
+        image = np.repeat(image[:, :, None], 3, axis=2)
+        clean = camera_features(camera_input(image, 'clean'))
+        dark = camera_features(camera_input(image, 'dark'))
+        blur = camera_features(camera_input(image, 'blur'))
+        gate = CameraQualityGate((dark[0] + clean[0]) / 2, (blur[1] + clean[1]) / 2)
+        self.assertEqual(gate.reason(*clean), 'accepted')
+        self.assertEqual(gate.reason(*dark), 'underexposed')
+        self.assertEqual(gate.reason(*blur), 'low_detail')
+        np.testing.assert_array_equal(image, camera_input(image, 'clean'))
+
+    def test_rejects_invalid_thresholds_and_scores(self):
+        for value in (-1, float('inf'), float('nan')):
+            with self.subTest(value=value), self.assertRaises(ValueError):
+                CameraQualityGate(20, value)
+        self.assertEqual(CameraQualityGate(20, 0.1).reason(50, float('nan')), 'invalid')
+
+
+if __name__ == '__main__':
+    unittest.main()
