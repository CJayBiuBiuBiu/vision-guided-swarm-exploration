diff --git a/turtlebot_ddpg/scripts/voronoi_exploration/depth_corridor.py b/turtlebot_ddpg/scripts/voronoi_exploration/depth_corridor.py
new file mode 100644
index 0000000..c51b996
--- /dev/null
+++ b/turtlebot_ddpg/scripts/voronoi_exploration/depth_corridor.py
@@ -0,0 +1,69 @@
+"""Project near-field depth returns and test the next commanded corridor."""
+
+import numpy as np
+from scipy.spatial.transform import Rotation
+
+
+# Waffle Pi RGB frame relative to base_footprint in the research launch.
+CAMERA_ORIGIN = np.array([0.076, 0.0, 0.103])
+LASER_ORIGIN = np.array([-0.064, 0.0, 0.132])
+MIN_HEIGHT_M = 0.035
+MAX_HEIGHT_M = 0.116
+MAX_SAMPLE_AGE_S = 0.40
+MAX_SENSOR_SKEW_S = 0.22
+MAX_POSE_SKEW_S = 0.10
+CORRIDOR_RADIUS_M = 0.175
+
+
+def depth_points(depth, intrinsics, pose):
+    """Return world XY points in a low obstacle band above the floor."""
+    fx, fy, cx, cy = intrinsics
+    if not np.isfinite(intrinsics).all() or fx <= 0 or fy <= 0:
+        raise ValueError("Invalid camera intrinsics")
+    rows, columns = np.indices(depth.shape)
+    valid = np.isfinite(depth) & (depth >= 0.25) & (depth <= 2.5)
+    distance = depth[valid]
+    optical = np.column_stack((distance, -(columns[valid] - cx) * distance / fx,
+                               -(rows[valid] - cy) * distance / fy))
+    position, orientation = pose
+    points = Rotation.from_quat(orientation).apply(optical + CAMERA_ORIGIN) + position
+    band = (points[:, 2] >= MIN_HEIGHT_M) & (points[:, 2] <= MAX_HEIGHT_M)
+    return points[band, :2]
+
+
+def laser_points(ranges, angle_min, increment, range_min, range_max, pose):
+    """Return world XY points from valid hits in the unchanged raw scan."""
+    ranges = np.asarray(ranges)
+    mask = np.isfinite(ranges) & (ranges >= range_min) & (ranges < range_max)
+    angles = angle_min + increment * np.flatnonzero(mask)
+    values = ranges[mask]
+    hits = np.column_stack((values * np.cos(angles), values * np.sin(angles),
+                            np.zeros_like(values)))
+    position, orientation = pose
+    return (Rotation.from_quat(orientation).apply(hits + LASER_ORIGIN) + position)[:, :2]
+
+
+def fresh_sample(sample, timestamp):
+    if sample is None or not 0 <= timestamp - sample[0] <= MAX_SAMPLE_AGE_S:
+        return None
+    return sample
+
+
+def corridor_hit(points, start, waypoint, minimum_points):
+    """Find the nearest supported hit inside the segment's swept footprint."""
+    direction = np.asarray(waypoint) - start
+    length = np.linalg.norm(direction)
+    if len(points) < minimum_points or length < 0.05:
+        return None
+    relative = points - start
+    unit = direction / length
+    projection = relative @ unit
+    nearest = np.clip(projection, 0, length)[:, None] * unit
+    corridor = (projection > 0) & (
+        np.linalg.norm(relative - nearest, axis=1) <= CORRIDOR_RADIUS_M)
+    indices = np.flatnonzero(corridor)
+    if len(indices) < minimum_points:
+        return None
+    first = indices[np.argmin(projection[indices])]
+    return dict(xy=points[first].tolist(), along_m=float(projection[first]),
+                support=int(len(indices)))
