diff --git a/turtlebot_ddpg/tests/test_depth_corridor.py b/turtlebot_ddpg/tests/test_depth_corridor.py
new file mode 100644
index 0000000..0621227
--- /dev/null
+++ b/turtlebot_ddpg/tests/test_depth_corridor.py
@@ -0,0 +1,48 @@
+import sys
+import unittest
+from pathlib import Path
+
+import numpy as np
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'scripts/voronoi_exploration'))
+from depth_corridor import corridor_hit, depth_points, fresh_sample, laser_points
+
+
+class DepthCorridorTests(unittest.TestCase):
+    def test_depth_keeps_low_obstacles_and_rejects_floor_and_invalid_depth(self):
+        image = np.full((15, 3), np.nan)
+        image[0, 1] = 1.0      # Above the height band
+        image[4, 1] = 1.0      # Low obstacle
+        image[14, 1] = 1.0     # Floor
+        image[5, 0] = np.inf
+        pose = ((0, 0, 0), (0, 0, 0, 1))
+        points = depth_points(image, (100, 100, 1, 3), pose)
+        np.testing.assert_allclose(points, [[1.076, 0.0]])
+
+    def test_depth_handles_no_hits_and_robot_yaw(self):
+        image = np.array([[1.0, np.nan]])
+        pose = ((1, 2, 0), (0, 0, np.sqrt(0.5), np.sqrt(0.5)))
+        np.testing.assert_allclose(depth_points(image, (100, 100, 0, 0), pose),
+                                   [[1.0, 3.076]])
+        self.assertEqual(depth_points(np.full((1, 1), np.nan),
+                                      (100, 100, 0, 0), pose).shape, (0, 2))
+
+    def test_intersection_uses_waypoint_and_support(self):
+        center = np.array([[0.9, 0.02], [0.95, -0.02], [0.91, 0.0], [0, -0.1],
+                           [0.2, 0.5], [1.5, 0], [-0.2, 0]])
+        hit = corridor_hit(center, np.zeros(2), (1.0, 0.0), 3)
+        self.assertEqual(hit['support'], 3)
+        self.assertAlmostEqual(hit['along_m'], 0.9)
+        self.assertIsNone(corridor_hit(center, np.zeros(2), (0.0, -1.0), 3))
+        self.assertIsNone(corridor_hit(center, np.zeros(2), (0.3, 0.0), 1))
+
+    def test_laser_filters_no_return_and_rotates_from_scan_frame(self):
+        pose = ((0, 0, 0), (0, 0, 1, 0))
+        hits = laser_points([1.0, 3.5, np.inf], 0, 0.1, 0.12, 3.5, pose)
+        np.testing.assert_allclose(hits, [[-0.936, 0.0]])
+
+    def test_stale_and_future_frames_are_unavailable(self):
+        sample = (1.0, object())
+        self.assertIs(fresh_sample(sample, 1.2), sample)
+        self.assertIsNone(fresh_sample(sample, 1.6))
+        self.assertIsNone(fresh_sample(sample, 0.9))
