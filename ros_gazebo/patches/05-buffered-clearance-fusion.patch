+def match_fusion_samples(rgb_history, lidar_history, now, pairing_mode):
+    """Keep a valid latest pair, or recover a recent pair from the buffers."""
+    if pairing_mode not in FUSION_PAIRING_MODES:
+        raise ValueError('unknown fusion pairing mode: %s' % pairing_mode)
+    rgb = rgb_history[-1] if rgb_history else None
+    lidar = lidar_history[-1] if lidar_history else None
+    rejection = (_sample_rejection(rgb, now, 'rgb') or
+                 _sample_rejection(lidar, now, 'lidar'))
+    if not rejection:
+        if abs(rgb[0] - lidar[0]) <= FUSION_MAX_SKEW:
+            return FusionMatch(rgb, lidar, 'latest', '')
+        rejection = 'timestamp_skew'
+    if pairing_mode == 'latest':
+        return FusionMatch(None, None, rejection, rejection)
+
+    recent_rgb = [sample for sample in rgb_history if _fresh(sample, now)]
+    recent_lidar = [sample for sample in lidar_history if _fresh(sample, now)]
+    candidates = ((r, l) for r in recent_rgb for l in recent_lidar
+                  if abs(r[0] - l[0]) <= FUSION_MAX_SKEW)
+    best = max(candidates, key=lambda pair: (
+        min(pair[0][0], pair[1][0]), -abs(pair[0][0] - pair[1][0])), default=None)
+    if best is not None:
+        return FusionMatch(best[0], best[1], 'buffered', rejection)
+    status = 'timestamp_skew' if recent_rgb and recent_lidar else rejection
+    return FusionMatch(None, None, status, rejection)
+
