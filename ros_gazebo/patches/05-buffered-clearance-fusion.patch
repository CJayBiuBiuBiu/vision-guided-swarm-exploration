+        self.assertIsNone(previous.rgb)
+        self.assertEqual(improved.status, 'buffered')
+        self.assertEqual(improved.latest_rejection, 'timestamp_skew')
+        self.assertEqual((improved.rgb, improved.lidar), (rgb[0], lidar[1]))
