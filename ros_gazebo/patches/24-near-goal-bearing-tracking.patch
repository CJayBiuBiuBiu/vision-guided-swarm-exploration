diff --git a/turtlebot_ddpg/scripts/voronoi_exploration/near_goal_tracking.py b/turtlebot_ddpg/scripts/voronoi_exploration/near_goal_tracking.py
new file mode 100644
index 0000000..2d1a125
--- /dev/null
+++ b/turtlebot_ddpg/scripts/voronoi_exploration/near_goal_tracking.py
@@ -0,0 +1,26 @@
+"""Track close waypoints geometrically while the filtered laser is clear."""
+
+import math
+
+
+LOCAL_TRACKING_MODES = ('ddpg', 'near_goal')
+NEAR_GOAL_RANGE_M = 1.0
+NEAR_GOAL_CLEARANCE_M = 0.35
+NEAR_GOAL_STOP_M = 0.08
+MAX_SCAN_AGE_S = 0.40
+FORWARD_ALIGNMENT_RAD = math.pi / 4
+
+
+def near_goal_command(distance_m, bearing_rad, clearance_m, scan_age_s):
+    """Return a bounded point-tracking action or defer to DDPG."""
+    if not all(math.isfinite(value) for value in (distance_m, bearing_rad, clearance_m, scan_age_s)):
+        return None
+    if not (0 <= distance_m <= NEAR_GOAL_RANGE_M and
+            clearance_m >= NEAR_GOAL_CLEARANCE_M and 0 <= scan_age_s <= MAX_SCAN_AGE_S):
+        return None
+    if distance_m <= NEAR_GOAL_STOP_M:
+        return 0.0, 0.0
+    alignment = max(0.0, 1.0 - abs(bearing_rad) / FORWARD_ALIGNMENT_RAD)
+    linear = min(0.20, 0.55 * distance_m) * alignment
+    angular = min(0.80, max(-0.80, 1.8 * bearing_rad))
+    return linear, angular
diff --git a/turtlebot_ddpg/tests/test_near_goal_tracking.py b/turtlebot_ddpg/tests/test_near_goal_tracking.py
new file mode 100644
index 0000000..8fba50b
--- /dev/null
+++ b/turtlebot_ddpg/tests/test_near_goal_tracking.py
@@ -0,0 +1,23 @@
+"""Check the near-goal action bounds and the handoff to the frozen policy."""
+
+import math
+from pathlib import Path
+import sys
+import unittest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'scripts/voronoi_exploration'))
+from near_goal_tracking import near_goal_command
+
+
+class NearGoalTrackingTests(unittest.TestCase):
+    def test_rotates_toward_a_close_target_before_advancing(self):
+        self.assertEqual(near_goal_command(0.60, math.pi / 2, 0.50, 0.10), (0.0, 0.80))
+        self.assertEqual(near_goal_command(0.60, -math.pi / 2, 0.50, 0.10), (0.0, -0.80))
+        self.assertEqual(near_goal_command(0.60, 0.0, 0.50, 0.10), (0.20, 0.0))
+        self.assertEqual(near_goal_command(0.05, 1.0, 0.50, 0.10), (0.0, 0.0))
+
+    def test_defers_when_clearance_distance_or_scan_age_is_outside_gate(self):
+        self.assertIsNone(near_goal_command(1.01, 0, 0.50, 0.10))
+        self.assertIsNone(near_goal_command(0.60, 0, 0.34, 0.10))
+        self.assertIsNone(near_goal_command(0.60, 0, 0.50, 0.41))
+        self.assertIsNone(near_goal_command(0.60, 0, math.nan, 0.10))
