diff --git a/turtlebot_ddpg/tests/test_active_passage.py b/turtlebot_ddpg/tests/test_active_passage.py
new file mode 100644
index 0000000..a34bac9
--- /dev/null
+++ b/turtlebot_ddpg/tests/test_active_passage.py
@@ -0,0 +1,82 @@
+"""Regression checks for bounded active passage sensing."""
+
+import math
+import sys
+import unittest
+from pathlib import Path
+
+import numpy as np
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'scripts/voronoi_exploration'))
+from active_passage import (angle_delta, continuation_point, corridor_is_free,
+                            fresh_score, inspection_candidate, rebind_candidate, scan_turn)
+from rgb_passage import BEARINGS_DEG, WIDTH_DISTANCES_M
+
+
+class ActivePassageTests(unittest.TestCase):
+    def test_scan_command_limits(self):
+        self.assertEqual(scan_turn(math.pi, 0, 1.0, 0.25, 0.1), 0.8)
+        self.assertEqual(scan_turn(-math.pi / 2, 0, 1.0, 0.25, 0.1), -0.8)
+        self.assertEqual(scan_turn(0.01, 0, 1.0, 0.25, 0.1), 0)
+        self.assertEqual(scan_turn(1, 0, 0.24, 0.25, 0.1), 0)
+        self.assertEqual(scan_turn(1, 0, float('nan'), 0.25, 0.1), 0)
+        self.assertEqual(scan_turn(1, 0, 1, 0.25, 0.81), 0)
+
+    def test_angle_wrap(self):
+        self.assertAlmostEqual(angle_delta(-math.pi + 0.1, math.pi - 0.1), 0.2)
+
+    def test_candidate_requires_affordable_unseen_direction(self):
+        cases = [(1, (1, 0), 1, None),
+                 (2, (0, 2), 1, {'clear_to_m': 4}),
+                 (3, (1, 1), 2.3, None),
+                 (4, (1, -1), 1.6, None),
+                 (5, (-1, 0), 1.2, None)]
+        self.assertEqual(inspection_candidate((0, 0), 0, 1, cases), 4)
+        self.assertIsNone(inspection_candidate((0, 0), 0, 1, cases[:3]))
+
+    def test_rebind_preserves_owned_spatial_identity(self):
+        frontiers = np.array([(0, 0), (0.3, 0.1), (1, 0), (0.2, 0)])
+        ids, owner = [20, 21, 22, 23], [1, 0, 0, 0]
+        self.assertEqual(rebind_candidate(frontiers, ids, owner, 0, 20, (0, 0)), 3)
+        self.assertEqual(rebind_candidate(frontiers, ids, owner, 0, 21, (0, 0)), 1)
+        self.assertEqual(rebind_candidate(frontiers, ids, owner, 0, 20, (0, 0), excluded=3), 1)
+        self.assertIsNone(rebind_candidate(frontiers, ids, owner, 0, 20, (-1, 0)))
+
+    def test_fresh_aligned_pair_after_scan(self):
+        widths = np.ones((len(BEARINGS_DEG), len(WIDTH_DISTANCES_M)))
+        frame = (np.array([0., 0., 0.]), math.pi / 2, widths)
+        frames = [(1.1, frame), (1.25, frame)]
+        score, stamps = fresh_score(frames, 1.3, (0, 0), (0, 4), after=1, align=True)
+        self.assertEqual(stamps, [1.1, 1.25])
+        self.assertEqual(score['clear_to_m'], 5.75)
+        for now, pos, target, after in [(1.6, (0, 0), (0, 4), 1),
+                                        (1.3, (0.3, 0), (0, 4), 1),
+                                        (1.3, (0, 0), (1, 4), 1),
+                                        (1.3, (0, 0), (0, 4), 1.2)]:
+            self.assertEqual(fresh_score(frames, now, pos, target, after, align=True), (None, []))
+
+    def setUp(self):
+        self.axis = np.arange(-2, 2.01, 0.2)
+        self.grid = np.ones((len(self.axis), len(self.axis)), dtype=np.uint8)
+
+    def test_continuation_respects_visible_distance(self):
+        target = continuation_point(self.grid, self.axis, self.axis, (0, 0), (1, 0), 1.1)
+        np.testing.assert_allclose(target, (0.85, 0))
+        self.assertIsNone(continuation_point(self.grid, self.axis, self.axis, (0, 0), (1, 0), 0.8))
+
+    def test_unseen_or_occupied_map_cells_block_corridor(self):
+        self.assertTrue(corridor_is_free(self.grid, self.axis, self.axis, (0, 0), (1.2, 0)))
+        for value in (0, 2):
+            self.grid[11, 12] = value
+            self.assertFalse(corridor_is_free(self.grid, self.axis, self.axis, (0, 0), (1.2, 0)))
+            self.assertIsNone(continuation_point(self.grid, self.axis, self.axis, (0, 0), (1, 0), 5.75))
+
+    def test_continuation_shortens_before_new_unknown(self):
+        self.grid[:, 16:] = 0
+        target = continuation_point(self.grid, self.axis, self.axis, (0, 0), (1, 0), 5.75)
+        np.testing.assert_allclose(target, (1.0, 0))
+        self.assertFalse(corridor_is_free(self.grid, self.axis, self.axis, (1.8, 0), (2.4, 0)))
+
+
+if __name__ == '__main__':
+    unittest.main()
