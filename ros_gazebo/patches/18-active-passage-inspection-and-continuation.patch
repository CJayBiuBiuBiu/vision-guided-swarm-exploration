+"""Bounded camera inspection and scan-map-validated passage continuation."""
+
+import math
+
+import numpy as np
+
+from rgb_passage import MAX_IMAGE_AGE_S, MAX_POSE_DRIFT_M, paired_width_score
+
+
+INSPECTION_Z = -3.0
+SCAN_TIMEOUT_S = 4.0
+SCAN_COOLDOWN_S = 12.0
+SCAN_MAX_EXTRA_ROUTE_M = 1.20
+SCAN_MIN_TURN = math.radians(25)
+SCAN_MAX_TURN = math.radians(100)
+SCAN_ALIGNMENT = math.radians(8)
+SCAN_REBIND_M = 0.60
+SCAN_COMMAND_AGE_S = 0.8
+CONTINUATION_STEP_M = 1.2
+CONTINUATION_MAX_STEPS = 2
+CONTINUATION_MAX_AGE_S = 45.0
+CONTINUATION_HOLD_S = 4.5
+
+
+def angle_delta(target, yaw):
+    return math.atan2(math.sin(target - yaw), math.cos(target - yaw))
+
+
+def heading(position, target):
+    return math.atan2(target[1] - position[1], target[0] - position[0])
+
+
+def scan_turn(target, yaw, clearance, minimum_clearance, age):
+    """Rotate in place only while the command and all-around clearance are valid."""
+    if not (0 <= age <= SCAN_COMMAND_AGE_S and math.isfinite(clearance)
+            and clearance > minimum_clearance):
+        return 0.0
+    error = angle_delta(target, yaw)
+    if abs(error) <= math.radians(3):
+        return 0.0
+    return max(-0.80, min(0.80, 1.8 * error))
+
+
+def inspection_candidate(position, yaw, preferred_length, candidates):
+    """Choose one affordable, currently unobserved candidate within a bounded turn."""
+    options = []
+    for index, target, length, score in candidates:
+        turn = abs(angle_delta(heading(position, target), yaw))
+        if (score is None and length is not None
+                and length <= preferred_length + SCAN_MAX_EXTRA_ROUTE_M
+                and SCAN_MIN_TURN <= turn <= SCAN_MAX_TURN):
+            options.append((turn, length, index))
+    return min(options)[2] if options else None
+
+
+def rebind_candidate(frontiers, ids, owner, robot_index, original_id, anchor, excluded=None):
+    """Keep an owned frontier associated by location when scan mapping moves its cluster."""
+    candidates = [index for index, fid in enumerate(ids)
+                  if owner[index] == robot_index and index != excluded
+                  and np.linalg.norm(frontiers[index] - anchor) <= SCAN_REBIND_M]
+    if not candidates:
+        return None
+    return min(candidates, key=lambda index: (ids[index] != original_id,
+                                             np.linalg.norm(frontiers[index] - anchor), index))
+
+
+def fresh_score(frames, now, position, target, after=None, align=False):
+    selected = [(stamp, frame) for stamp, frame in frames
+                if frame is not None and 0 <= now - stamp <= MAX_IMAGE_AGE_S
+                and (after is None or stamp >= after)
+                and np.linalg.norm(np.asarray(position) - frame[0][:2]) <= MAX_POSE_DRIFT_M]
+    if align:
+        selected = [(stamp, frame) for stamp, frame in selected
+                    if abs(angle_delta(heading(frame[0], target), frame[1])) <= SCAN_ALIGNMENT]
+    if len(selected) != 2:
+        return None, []
+    return paired_width_score(tuple(frame for _, frame in selected), target), [
+        stamp for stamp, _ in selected]
+
+
+def corridor_is_free(grid, xs, ys, origin, target):
+    """Require the complete sampled body footprint to lie in observed free cells."""
+    origin, target = np.asarray(origin), np.asarray(target)
+    delta = target - origin
+    length = np.linalg.norm(delta)
+    if length <= 1e-9:
+        return False
+    resolution = float(xs[1] - xs[0])
+    direction = delta / length
+    sideways = np.asarray([-direction[1], direction[0]])
+    samples = (origin + np.linspace(0, length, max(2, int(math.ceil(length / (resolution / 2))) + 1))[:, None, None]
+               * direction[None, None, :] + np.asarray([-0.183, 0.0, 0.183])[None, :, None]
+               * sideways[None, None, :])
+    ix = np.floor((samples[..., 0] - xs[0] + resolution / 2) / resolution).astype(int)
+    iy = np.floor((samples[..., 1] - ys[0] + resolution / 2) / resolution).astype(int)
+    if ((ix < 0) | (ix >= len(xs)) | (iy < 0) | (iy >= len(ys))).any():
+        return False
+    return bool((grid[iy, ix] == 1).all())
+
+
+def continuation_point(grid, xs, ys, position, direction, clear_distance):
+    """Extend a direction only through camera-visible, scan-confirmed free space."""
+    position, direction = np.asarray(position), np.asarray(direction)
+    maximum = min(CONTINUATION_STEP_M, clear_distance - 0.25)
+    for distance in np.arange(maximum, 0.65, -0.20):
+        target = position + direction * distance
+        if corridor_is_free(grid, xs, ys, position, target):
+            return target
+    return None
