+def weak_wait_preference(wait_margin, maximum_margin, can_continue, can_wait):
+    """Whether a deterministic WAIT warrants checking the active route."""
+    return (maximum_margin > 0.0 and can_continue and can_wait and
+            wait_margin is not None and math.isfinite(wait_margin) and
+            0.0 <= wait_margin <= maximum_margin)
 
 
