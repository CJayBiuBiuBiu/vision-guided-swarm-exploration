-from policy_goal import wait_hold_gate
+from policy_goal import wait_hold_gate, weak_wait_preference
 from safety_metrics import ClearanceTelemetry
 
 
 class PolicyGoalTests(unittest.TestCase):
+    def test_wait_margin_preserves_mask_and_definite_waits(self):
+        for gap in (0.0, 0.05, 0.1):
+            self.assertTrue(weak_wait_preference(gap, 0.1, True, True))
+        for gap in (None, float('nan'), -0.05, 0.11):
+            self.assertFalse(weak_wait_preference(gap, 0.1, True, True))
+        self.assertFalse(weak_wait_preference(0.0, 0.0, True, True))
+        self.assertFalse(weak_wait_preference(0.05, 0.1, False, True))
+        self.assertFalse(weak_wait_preference(0.05, 0.1, True, False))
+
     def test_wait_checks_route_only_for_a_young_clear_goal(self):
         self.assertEqual(wait_hold_gate(1.5, 4.5, 0.50, 0.25), 'check_route')
         self.assertEqual(wait_hold_gate(4.5, 4.5, 0.50, 0.25), 'hold_elapsed')
