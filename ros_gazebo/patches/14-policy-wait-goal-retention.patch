diff --git a/turtlebot_ddpg/scripts/voronoi_exploration/policy_goal.py b/turtlebot_ddpg/scripts/voronoi_exploration/policy_goal.py
new file mode 100644
index 0000000..da0a59e
--- /dev/null
+++ b/turtlebot_ddpg/scripts/voronoi_exploration/policy_goal.py
@@ -0,0 +1,20 @@
+"""Short policy goal retention using independent clearance checks."""
+
+import math
+
+
+WAIT_MODES = ('legacy', 'cancel', 'hold')
+POLICY_IDLE_Z = -2.0
+
+
+def wait_hold_gate(goal_age_s, hold_s, clearance_m, minimum_clearance_m):
+    """Return whether checking a young goal's route is worthwhile."""
+    if goal_age_s is None:
+        return 'no_active_goal'
+    if not math.isfinite(goal_age_s) or not 0 <= goal_age_s < hold_s:
+        return 'hold_elapsed'
+    if clearance_m is None or not math.isfinite(clearance_m):
+        return 'clearance_missing_or_stale'
+    if clearance_m <= minimum_clearance_m:
+        return 'clearance_low'
+    return 'check_route'
