diff --git a/turtlebot_ddpg/tests/test_policy_goal.py b/turtlebot_ddpg/tests/test_policy_goal.py
new file mode 100644
index 0000000..bcf3dc1
--- /dev/null
+++ b/turtlebot_ddpg/tests/test_policy_goal.py
@@ -0,0 +1,24 @@
+import sys
+import unittest
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'scripts/voronoi_exploration'))
+from policy_goal import wait_hold_gate
+from safety_metrics import ClearanceTelemetry
+
+
+class PolicyGoalTests(unittest.TestCase):
+    def test_wait_checks_route_only_for_a_young_clear_goal(self):
+        self.assertEqual(wait_hold_gate(1.5, 4.5, 0.50, 0.25), 'check_route')
+        self.assertEqual(wait_hold_gate(4.5, 4.5, 0.50, 0.25), 'hold_elapsed')
+        self.assertEqual(wait_hold_gate(-0.1, 4.5, 0.50, 0.25), 'hold_elapsed')
+        self.assertEqual(wait_hold_gate(None, 4.5, 0.50, 0.25), 'no_active_goal')
+        self.assertEqual(wait_hold_gate(1.5, 4.5, None, 0.25), 'clearance_missing_or_stale')
+        self.assertEqual(wait_hold_gate(1.5, 4.5, 0.25, 0.25), 'clearance_low')
+
+    def test_freshness_uses_the_same_bounded_telemetry_clock(self):
+        telemetry = ClearanceTelemetry(max_sample_gap=0.5)
+        telemetry.observe('robot1', 0.40, 5.0)
+        self.assertEqual(telemetry.recent_clearance('robot1', 5.4), 0.4)
+        self.assertIsNone(telemetry.recent_clearance('robot1', 5.6))
+        self.assertIsNone(telemetry.recent_clearance('robot1', 4.0))
