+CAMERA_RUN_PROFILES = CAMERA_PROFILES + ('mixed',)
+MIXED_WINDOWS = ('clean', 'dark', 'clean', 'dark', 'clean')
+MIXED_WINDOW_SECONDS = 60.0
+
+
+def mixed_window(stamp_s):
+    """Return the exposure window on the Gazebo clock."""
+    if not math.isfinite(stamp_s) or stamp_s < 0:
+        raise ValueError('Invalid simulation stamp for mixed camera exposure')
+    return min(int(stamp_s // MIXED_WINDOW_SECONDS), len(MIXED_WINDOWS) - 1)
 
 
