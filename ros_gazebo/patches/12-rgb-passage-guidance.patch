@@ -0,0 +1,66 @@
+"""Mirrored doorway scenes for testing RGB information beyond scan range."""
+
+DOOR_X = 1.5
+DOOR_HALF_WIDTH = 0.75
+STAGING_Y = 4.30
+ARENA = (-4.8, -5.0, 4.8, 5.0)
+
+
+def profile(open_side):
+    inner = DOOR_X - DOOR_HALF_WIDTH
+    outer = DOOR_X + DOOR_HALF_WIDTH
+    gaps = {1: (inner, outer), -1: (-outer, -inner)}
+    left, right = gaps[open_side]
+    return {'arena': ARENA, 'obstacles': [
+        (ARENA[0], -0.1, left, 0.1),
+        (right, -0.1, ARENA[2], 0.1),
+    ]}
+
+
+PASSAGE_PROFILES = {
+    'passage_left_open': profile(1),
+    'passage_right_open': profile(-1),
+}
+
+
+def box(name, bounds, height, z, colour):
+    x0, y0, x1, y1 = bounds
+    return f"""<model name="{name}"><static>true</static>
+      <pose>{(x0 + x1) / 2} {(y0 + y1) / 2} {z} 0 0 0</pose>
+      <link name="link">
+        <collision name="collision">
+          <geometry><box><size>{x1 - x0} {y1 - y0} {height}</size></box></geometry>
+        </collision>
+        <visual name="visual">
+          <geometry><box><size>{x1 - x0} {y1 - y0} {height}</size></box></geometry>
+          <material><ambient>{colour} 1</ambient><diffuse>{colour} 1</diffuse></material>
+        </visual>
+      </link>
+    </model>"""
+
+
+def world_xml(world):
+    x0, y0, x1, y1 = ARENA
+    thickness = 0.15
+    boundary = [
+        (x0 - thickness, y0, x0, y1),
+        (x1, y0, x1 + thickness, y1),
+        (x0 - thickness, y0 - thickness, x1 + thickness, y0),
+        (x0 - thickness, y1, x1 + thickness, y1 + thickness),
+    ]
+    walls = PASSAGE_PROFILES[world]['obstacles'] + boundary
+    obstacles = '\n'.join(box(f'wall_{index}', bounds, 0.8, 0.4, '0.26 0.29 0.34')
+                          for index, bounds in enumerate(walls))
+    floor = box('floor', (x0 - 1, y0 - 1, x1 + 1, y1 + 1), 0.1, -0.05, '0.62 0.62 0.62')
+    return f"""<?xml version="1.0" ?>
+<sdf version="1.6"><world name="{world}">
+    <scene><ambient>0.7 0.7 0.7 1</ambient><background>0.55 0.55 0.55 1</background>
+      <shadows>false</shadows></scene>
+    <light name="downlight" type="directional">
+      <cast_shadows>false</cast_shadows><direction>0 0 -1</direction>
+      <diffuse>0.45 0.45 0.45 1</diffuse><specular>0 0 0 1</specular>
+    </light>
+    {floor}
+    {obstacles}
+</world></sdf>
+"""
diff --git a/turtlebot_ddpg/scripts/voronoi_exploration/rgb_passage.py b/turtlebot_ddpg/scripts/voronoi_exploration/rgb_passage.py
new file mode 100644
index 0000000..07137f0
--- /dev/null
+++ b/turtlebot_ddpg/scripts/voronoi_exploration/rgb_passage.py
@@ -0,0 +1,118 @@
+"""Estimate visible floor continuation beyond the Waffle Pi's planar LiDAR."""
+
+import math
+
+import numpy as np
+from scipy.spatial.transform import Rotation
+
+from depth_corridor import CAMERA_ORIGIN
+
+
+BEARINGS_DEG = np.arange(-28.0, 29.0, 2.0)
+NEAR_DISTANCES = (2.0, 2.6, 3.1)
+FAR_DISTANCES = (3.85, 4.25, 4.65, 5.15, 5.65)
+LATERAL_OFFSETS = np.array([-0.20, -0.10, 0.0, 0.10, 0.20])
+MAX_IMAGE_AGE_S = 0.40
+MAX_POSE_DRIFT_M = 0.25
+MIN_NEAR_SCORE = 0.75
+MAX_BLOCKED_SCORE = 0.35
+MIN_OPEN_SCORE = 0.80
+MAX_EXTRA_ROUTE_M = 0.60
+
+
+def project_floor(shape, intrinsics, pose, bearings_deg, distances, offsets):
+    """Return pixel coordinates for horizontal, heading-relative floor samples."""
+    position, quaternion = pose
+    body = Rotation.from_quat(quaternion)
+    forward = body.apply([1.0, 0.0, 0.0])
+    yaw = math.atan2(forward[1], forward[0])
+    heading = Rotation.from_rotvec([0.0, 0.0, yaw])
+    relative = (body.inv() * heading).as_matrix()
+    angle = np.deg2rad(bearings_deg)[:, None, None]
+    distance = np.asarray(distances)[None, :, None]
+    lateral = np.asarray(offsets)[None, None, :]
+    x = np.cos(angle) * distance - np.sin(angle) * lateral
+    y = np.sin(angle) * distance + np.cos(angle) * lateral
+    points = np.stack((x, y, np.full_like(x, -position[2])), axis=-1)
+    optical = points @ relative.T - CAMERA_ORIGIN
+    fx, fy, cx, cy = intrinsics
+    depth = optical[..., 0]
+    with np.errstate(divide='ignore', invalid='ignore'):
+        u = cx - fx * optical[..., 1] / depth
+        v = cy - fy * optical[..., 2] / depth
+    valid = ((depth > 0) & (u >= 0) & (u < shape[1] - 1)
+             & (v >= 0) & (v < shape[0] - 1))
+    return u, v, valid, yaw
+
+
+def floor_samples(image, intrinsics, pose, bearings, distances, offsets):
+    u, v, valid, yaw = project_floor(
+        image.shape, intrinsics, pose, bearings, distances, offsets)
+    u, v = np.where(valid, u, 0.0), np.where(valid, v, 0.0)
+    x, y = u.astype(int), v.astype(int)
+    du, dv = (u - x)[..., None], (v - y)[..., None]
+    top = (1 - du) * image[y, x] + du * image[y, x + 1]
+    bottom = (1 - du) * image[y + 1, x] + du * image[y + 1, x + 1]
+    return (1 - dv) * top + dv * bottom, valid, yaw
+
+
+def measure_passage(image, intrinsics, pose):
+    """Return the frame yaw, near score and beyond-range score for each bearing."""
+    reference, valid, yaw = floor_samples(
+        image, intrinsics, pose, [0.0], [0.50, 0.60, 0.75], LATERAL_OFFSETS)
+    if not valid.all():
+        return None
+    reference_rgb = np.median(reference, axis=(0, 1, 2))
+    spread = np.max(np.linalg.norm(reference - reference_rgb, axis=-1))
+    if not 35 <= reference_rgb.mean() <= 235 or spread > 32:
+        return None
+    samples, valid, _ = floor_samples(
+        image, intrinsics, pose, BEARINGS_DEG, NEAR_DISTANCES + FAR_DISTANCES,
+        LATERAL_OFFSETS)
+    error = np.linalg.norm(samples - reference_rgb, axis=-1)
+    floor_likelihood = np.clip((48.0 - error) / 28.0, 0.0, 1.0)
+    band_score = floor_likelihood.mean(axis=-1)
+    near_count = len(NEAR_DISTANCES)
+    near = band_score[:, :near_count].min(axis=1)
+    far = band_score[:, near_count:].min(axis=1)
+    invalid = ~valid.all(axis=(1, 2))
+    near[invalid] = np.nan
+    far[invalid | (near < MIN_NEAR_SCORE)] = np.nan
+    return yaw, near, far
+
+
+def score_direction(sample, target_xy):
+    """Look up the nearest measured bearing without extrapolating the image."""
+    position, yaw, near, far = sample
+    bearing = math.atan2(target_xy[1] - position[1], target_xy[0] - position[0]) - yaw
+    angle = math.degrees(math.atan2(math.sin(bearing), math.cos(bearing)))
+    if not BEARINGS_DEG[0] <= angle <= BEARINGS_DEG[-1]:
+        return None
+    index = int(np.argmin(np.abs(BEARINGS_DEG - angle)))
+    if not np.isfinite(far[index]):
+        return None
+    return {'bearing_deg': angle, 'near': float(near[index]), 'far': float(far[index])}
+
+
+def propose_passage(preferred, candidates, sample, grid_resolution):
+    """Suggest a reachable, similarly short path toward camera-visible floor."""
+    _, preferred_path = candidates[preferred]
+    scores = {index: score_direction(sample, xy)
+              for index, (xy, _) in candidates.items()}
+    preferred_score = scores[preferred]
+    if not preferred_path or preferred_score is None or preferred_score['far'] > MAX_BLOCKED_SCORE:
+        return preferred, scores
+    maximum = route_length(preferred_path, grid_resolution) + MAX_EXTRA_ROUTE_M
+    choices = []
+    for index, (_, path) in candidates.items():
+        score = scores[index]
+        if index != preferred and path and score is not None and score['far'] >= MIN_OPEN_SCORE:
+            length = route_length(path, grid_resolution)
+            if length <= maximum + 1e-9:
+                choices.append((length, -score['far'], index))
+    return min(choices)[-1] if choices else preferred, scores
+
+
+def route_length(path, resolution):
+    return resolution * sum(math.hypot(x1 - x0, y1 - y0)
+                            for (x0, y0), (x1, y1) in zip(path, path[1:]))
