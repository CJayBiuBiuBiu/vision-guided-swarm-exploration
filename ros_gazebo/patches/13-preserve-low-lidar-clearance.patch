@@ -11,7 +11,9 @@ LIDAR_OPENNESS = 'lidar_openness'
 RGB_LIDAR_OPENNESS = 'rgb_lidar_openness'
 MATCHED_CLEARANCE = 'matched_directional_clearance'
 CLEARANCE_MODES = (RGB_OPENNESS, LIDAR_OPENNESS, RGB_LIDAR_OPENNESS, MATCHED_CLEARANCE)
-MATCHED_CUES = ('lidar', 'fusion', 'adaptive')
+MATCHED_CUES = ('lidar', 'fusion', 'adaptive', 'guarded_fusion')
+GUARD_CLEARANCE_LIMIT = 0.25
+GUARD_FULL_FUSION = 0.50
 SCORE_MAX_AGE = 0.75
 FUSION_MAX_SKEW = 0.25
 FUSION_PAIRING_MODES = ('latest', 'buffered')
@@ -109,13 +111,25 @@ def clearance_scores(mode, rgb, lidar, now, rgb_weight):
                  for r, l in zip(rgb[1], lidar[1]))
 
 
+def guarded_clearance(lidar, rgb, rgb_weight):
+    """Keep low scan scores and blend gradually across the next score band."""
+    width = GUARD_FULL_FUSION - GUARD_CLEARANCE_LIMIT
+    guarded = []
+    for scan, image in zip(lidar, rgb):
+        gain = min(1.0, max(0.0, (scan - GUARD_CLEARANCE_LIMIT) / width))
+        weight = rgb_weight * gain
+        guarded.append((1.0 - weight) * scan + weight * image)
+    return tuple(guarded)
+
+
 def matched_clearance_cues(match, latest_lidar, now, rgb_weight, trusted_rgb=False):
     """Build both cues from one scan and return that scan's source stamp."""
     if match.lidar is not None:
         lidar, rgb = match.lidar, match.rgb
         fusion = clearance_scores(RGB_LIDAR_OPENNESS, rgb, lidar, now, rgb_weight)
         return {'lidar': lidar[1], 'fusion': fusion,
-                'adaptive': fusion if trusted_rgb else lidar[1]}, lidar[0]
+                'adaptive': fusion if trusted_rgb else lidar[1],
+                'guarded_fusion': guarded_clearance(lidar[1], rgb[1], rgb_weight)}, lidar[0]
     if _fresh(latest_lidar, now):
         return dict.fromkeys(MATCHED_CUES, latest_lidar[1]), latest_lidar[0]
     return dict.fromkeys(MATCHED_CUES), None
