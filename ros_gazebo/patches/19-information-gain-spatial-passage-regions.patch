+        widths = np.ones((len(BEARINGS_DEG), len(WIDTH_DISTANCES_M)))
+        sample = (np.array([0., 0., 0.]), math.pi / 2, widths)
+        coord.passage_width_frames['robot1'] = [(10.8, sample), (10.9, sample)]
+        coord._control_now.return_value = 11.0
+        waiting, choice = coord._advance_gain_inspection(
