new file mode 100644
index 0000000..5ad11e0
--- /dev/null
+++ b/turtlebot_ddpg/scripts/voronoi_exploration/passage_information.py
@@ -0,0 +1,102 @@
+"""Estimate scan-unknown area supported by a paired RGB corridor measurement."""
+
+import base64
+import math
+import zlib
+
+import numpy as np
+
+from active_passage import (
+    SCAN_MAX_TURN, SCAN_MIN_TURN, angle_delta, heading,
+)
+
+
+MIN_GAIN_CELLS = 6
+MIN_ADVANTAGE_CELLS = 4
+REGION_RADIUS_M = 1.20
+REGION_BEARING_RAD = math.radians(15)
+CORRIDOR_HALF_WIDTH_M = 0.25
+GAIN_RANGE_M = 5.75
+GAIN_MARGIN_M = 0.25
+
+
+def unknown_corridor_cells(grid, xs, ys, origin, target, score=None):
+    """Count unique unknown cell centres after the target, before observed obstacles.
+
+    With no RGB score this is an optimistic inspection potential, not confirmed
+    visual information. The calculation never modifies occupancy or permits motion.
+    """
+    origin, target = np.asarray(origin), np.asarray(target)
+    delta = target - origin
+    distance = float(np.linalg.norm(delta))
+    if distance <= 1e-9:
+        return 0
+    forward = delta / distance
+    sideways = np.array([-forward[1], forward[0]])
+    x, y = np.meshgrid(xs - origin[0], ys - origin[1])
+    longitudinal = x * forward[0] + y * forward[1]
+    lateral = x * sideways[0] + y * sideways[1]
+    corridor = np.abs(lateral) <= CORRIDOR_HALF_WIDTH_M + 1e-9
+    clear_to = GAIN_RANGE_M if score is None else score['clear_to_m']
+    start = 1.0 if score is None else score['starts_m']
+    obstacles = longitudinal[corridor & (longitudinal >= 0.35 - 1e-9) & (grid == 2)]
+    if obstacles.size:
+        clear_to = min(clear_to, float(obstacles.min()))
+    end = clear_to - GAIN_MARGIN_M
+    first = max(start, distance - GAIN_MARGIN_M)
+    return int(np.count_nonzero(corridor & (longitudinal >= first - 1e-9)
+                                & (longitudinal <= end + 1e-9) & (grid == 0)))
+
+
+def useful_gain(cells, baseline):
+    return cells >= MIN_GAIN_CELLS and cells >= baseline + MIN_ADVANTAGE_CELLS
+
+
+def select_gain(rows, preferred, baseline, route_cap):
+    """Choose the highest measured gain among reachable, affordable alternatives."""
+    eligible = [row for row in rows if row['index'] != preferred and row['score'] is not None
+                and useful_gain(row['gain_cells'], baseline) and row['route_m'] is not None
+                and row['route_m'] <= route_cap + 1e-9]
+    if not eligible:
+        return None
+    return min(eligible, key=lambda row: (-row['gain_cells'], row['route_m'],
+                                         -row['score']['clear_to_m'], row['index']))['index']
+
+
+def select_inspection(rows, preferred, baseline, route_cap, origin, yaw):
+    """Spend bounded rotation time only when an unobserved region may add information."""
+    choices = []
+    for row in rows:
+        turn = abs(angle_delta(heading(origin, row['xy']), yaw))
+        if (row['index'] != preferred and row['score'] is None
+                and useful_gain(row['potential_cells'], baseline) and row['route_m'] is not None
+                and row['route_m'] <= route_cap + 1e-9 and SCAN_MIN_TURN <= turn <= SCAN_MAX_TURN):
+            choices.append((-row['potential_cells'], turn, row['route_m'], row['index']))
+    return min(choices)[-1] if choices else None
+
+
+def region_indices(frontiers, owner, robot_index, origin, anchor, excluded=None):
+    """Associate a fixed world-coordinate inspection ray with current owned frontiers."""
+    bearing = heading(origin, anchor)
+    matches = [index for index, xy in enumerate(frontiers)
+               if owner[index] == robot_index and index != excluded
+               and np.linalg.norm(xy - anchor) <= REGION_RADIUS_M
+               and abs(angle_delta(heading(origin, xy), bearing)) <= REGION_BEARING_RAD]
+    return sorted(matches, key=lambda index: (float(np.linalg.norm(frontiers[index] - anchor)), index))
+
+
+def map_evidence(grid, xs, ys):
+    """Compact exact observed-map snapshot for replay of every ranking decision."""
+    return dict(shape=list(grid.shape), origin=[float(xs[0]), float(ys[0])],
+                resolution=float(xs[1] - xs[0]),
+                cells=base64.b64encode(zlib.compress(grid.astype(np.uint8).tobytes())).decode('ascii'))
+
+
+def restore_map(record):
+    grid = np.frombuffer(zlib.decompress(base64.b64decode(record['cells'])), dtype=np.uint8)
+    grid = grid.reshape(record['shape'])
+    if not np.isin(grid, (0, 1, 2)).all():
+        raise ValueError('Invalid scan-map values')
+    ny, nx = grid.shape
+    res = record['resolution']
+    return grid, record['origin'][0] + np.arange(nx) * res, record['origin'][1] + np.arange(ny) * res
