+"""Directional frontier cues using the RGB encoder's clearance convention."""
+
+import math
+
+import numpy as np
+
+
+RGB_OPENNESS = 'learned_openness'
+LIDAR_OPENNESS = 'lidar_openness'
+RGB_LIDAR_OPENNESS = 'rgb_lidar_openness'
+CLEARANCE_MODES = (RGB_OPENNESS, LIDAR_OPENNESS, RGB_LIDAR_OPENNESS)
+SCORE_MAX_AGE = 0.75
+FUSION_MAX_SKEW = 0.25
+
+
+def lidar_openness(ranges, angle_min, angle_increment, range_min, range_max,
+                   camera_fov):
+    """Use the historical camera-label quantile and require all three sectors."""
+    values = np.asarray(ranges, dtype=np.float32)
+    scan_parameters = (angle_min, angle_increment, range_min, range_max, camera_fov)
+    if (values.ndim != 1 or not values.size or
+            not all(math.isfinite(value) for value in scan_parameters) or
+            angle_increment == 0.0 or not 0.0 < camera_fov <= 2.0 * math.pi or
+            not 0.0 <= range_min < range_max):
+        return None
+
+    angles = angle_min + np.arange(values.size) * angle_increment
+    if angles.min() < -math.pi or angles.max() > math.pi:
+        angles = (angles + math.pi) % (2.0 * math.pi) - math.pi
+    no_return = np.isposinf(values)
+    valid = (np.isfinite(values) & (values >= range_min)) | no_return
+    clipped = np.clip(np.where(no_return, range_max, values), range_min, range_max)
+    half_fov, third = camera_fov / 2.0, camera_fov / 6.0
+    # Match the camera-label convention in the dissertation model.
+    regions = (
+        (angles >= -half_fov) & (angles <= -third),
+        (angles > -third) & (angles < third),
+        (angles >= third) & (angles <= half_fov),
+    )
+    scores = []
+    for region in regions:
+        samples = clipped[region & valid]
+        if not samples.size:
+            return None
+        clearance = float(np.quantile(samples, 0.25))
+        scores.append((clearance - range_min) / (range_max - range_min))
+    return tuple(float(np.clip(score, 0.0, 1.0)) for score in scores)
+
+
+def _fresh(sample, now):
+    return sample is not None and 0.0 <= now - sample[0] <= SCORE_MAX_AGE
+
+
+def clearance_scores(mode, rgb, lidar, now, rgb_weight):
+    """Resolve timestamped sensor samples into one clearance score per sector."""
+    if mode == RGB_OPENNESS:
+        return rgb[1] if _fresh(rgb, now) else None
+    if mode == LIDAR_OPENNESS:
+        return lidar[1] if _fresh(lidar, now) else None
+    if mode != RGB_LIDAR_OPENNESS:
+        raise ValueError('unknown clearance mode: %s' % mode)
+    if (not _fresh(rgb, now) or not _fresh(lidar, now) or
+            abs(rgb[0] - lidar[0]) > FUSION_MAX_SKEW):
+        return None
+    return tuple(rgb_weight * r + (1.0 - rgb_weight) * l
+                 for r, l in zip(rgb[1], lidar[1]))
