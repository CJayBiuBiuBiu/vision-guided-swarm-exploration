index 0000000000000000000000000000000000000000..a43155e02621acf5d017ecdc70eff9e8f8827b80
--- /dev/null
+++ b/turtlebot_ddpg/scripts/voronoi_exploration/learned_clearance.py
@@ -0,0 +1,48 @@
+"""Load and run the dissertation's format-2 RGB clearance checkpoint."""
+
+import cv2
+import numpy as np
+import torch
+from torch import nn
+
+
+class TinyOpennessCNN(nn.Module):
+    """Preserve the model architecture and parameter keys in the archive."""
+
+    def __init__(self):
+        super().__init__()
+        self.features = nn.Sequential(
+            nn.Conv2d(3, 16, 5, stride=2, padding=2), nn.ReLU(inplace=True),
+            nn.Conv2d(16, 32, 3, stride=2, padding=1), nn.ReLU(inplace=True),
+            nn.Conv2d(32, 64, 3, stride=2, padding=1), nn.ReLU(inplace=True),
+            nn.Conv2d(64, 64, 3, stride=2, padding=1), nn.ReLU(inplace=True),
+            nn.AdaptiveAvgPool2d((1, 3)))
+        self.head = nn.Linear(64 * 3, 3)
+
+    def forward(self, images):
+        return self.head(self.features(images).flatten(1))
+
+
+class LearnedVisionScorer:
+    """Run deterministic, single-frame inference with the frozen encoder."""
+
+    def __init__(self, checkpoint_path):
+        checkpoint = torch.load(str(checkpoint_path), map_location='cpu', weights_only=True)
+        if checkpoint.get('format_version') != 2:
+            raise ValueError('unsupported learned-vision checkpoint format')
+        if tuple(checkpoint.get('output_names', ())) != ('left', 'centre', 'right'):
+            raise ValueError('checkpoint outputs must be left, centre, right')
+        height, width = (int(value) for value in checkpoint.get('input_size', (96, 160)))
+        if height <= 0 or width <= 0:
+            raise ValueError('checkpoint input dimensions must be positive')
+        self.size = (width, height)
+        self.model = TinyOpennessCNN()
+        self.model.load_state_dict(checkpoint['model_state_dict'])
+        self.model.eval()
+
+    def score(self, image_rgb):
+        resized = cv2.resize(image_rgb, self.size, interpolation=cv2.INTER_AREA)
+        channels = np.transpose(resized.astype(np.float32) / 255.0, (2, 0, 1))
+        with torch.inference_mode():
+            scores = torch.sigmoid(self.model(torch.from_numpy(channels[None])))[0]
+        return tuple(float(score) for score in scores)
