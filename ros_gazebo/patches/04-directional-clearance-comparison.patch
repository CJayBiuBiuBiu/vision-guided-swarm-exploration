@@ -0,0 +1,58 @@
+import math
+import os
+import sys
+import unittest
+
+import numpy as np
+
+
+SCRIPT_DIR = os.path.join(os.path.dirname(os.path.dirname(__file__)),
+                          'scripts', 'voronoi_exploration')
+sys.path.insert(0, SCRIPT_DIR)
+
+from directional_clearance import (
+    LIDAR_OPENNESS, RGB_LIDAR_OPENNESS, RGB_OPENNESS, clearance_scores,
+    lidar_openness)
+
+
+class LidarOpennessTests(unittest.TestCase):
+    def test_lower_quartile_and_direction_match_rgb_label_convention(self):
+        scan = [0.2, 1.0, 1.0, 1.0, 2.0, 2.0, 2.0, 3.0, 3.0, math.inf, math.inf]
+        left, centre, right = lidar_openness(scan, -0.5, 0.1, 0.2, 4.0, 1.1)
+        np.testing.assert_allclose((left, centre, right),
+                                   ((0.8 - 0.2) / 3.8, (2 - 0.2) / 3.8,
+                                    (3 - 0.2) / 3.8))
+
+    def test_scan_angles_wrap_around_the_forward_direction(self):
+        increment = math.pi / 10
+        full_turn = [2.0] * 20
+        full_turn[1] = 3.0
+        full_turn[-1] = 1.0
+        scores = lidar_openness(full_turn, 0.0, increment, 0.1, 4.0, 1.2)
+        self.assertLess(scores[0], scores[1])
+        self.assertLess(scores[1], scores[2])
+
+    def test_no_return_is_open_and_a_missing_sector_invalidates_the_sample(self):
+        self.assertEqual(lidar_openness([math.inf] * 11, -0.5, 0.1, 0.1, 3.5, 1.1),
+                         (1.0, 1.0, 1.0))
+        self.assertIsNone(lidar_openness([math.nan] * 4 + [2.0] * 7,
+                                          -0.5, 0.1, 0.1, 3.5, 1.1))
+        self.assertIsNone(lidar_openness([2.0] * 11, -0.5, 0.1, 3.5, 0.1, 1.1))
+
+
+class ClearanceSourceTests(unittest.TestCase):
+    def test_single_modality_does_not_depend_on_the_other_stream(self):
+        sample = (10.0, (0.25, 0.5, 0.75))
+        self.assertEqual(clearance_scores(RGB_OPENNESS, sample, None, 10.2, 0.5), sample[1])
+        self.assertEqual(clearance_scores(LIDAR_OPENNESS, None, sample, 10.2, 0.5), sample[1])
+        self.assertIsNone(clearance_scores(RGB_OPENNESS, sample, None, 11.0, 0.5))
+        self.assertIsNone(clearance_scores(LIDAR_OPENNESS, None, sample, 9.9, 0.5))
+
+    def test_fusion_aligns_samples_and_does_not_switch_to_a_single_modality(self):
+        rgb = (10.0, (1.0, 0.5, 0.0))
+        lidar = (10.125, (0.0, 0.5, 1.0))
+        self.assertEqual(clearance_scores(RGB_LIDAR_OPENNESS, rgb, lidar, 10.25, 0.25),
+                         (0.25, 0.5, 0.75))
+        self.assertIsNone(clearance_scores(RGB_LIDAR_OPENNESS, rgb, None, 10.25, 0.5))
+        misaligned = (10.375, lidar[1])
+        self.assertIsNone(clearance_scores(RGB_LIDAR_OPENNESS, rgb, misaligned, 10.5, 0.5))
