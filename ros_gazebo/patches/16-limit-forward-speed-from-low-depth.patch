new file mode 100644
index 0000000..d3ff42d
--- /dev/null
+++ b/turtlebot_ddpg/scripts/voronoi_exploration/depth_velocity.py
@@ -0,0 +1,54 @@
+"""Forward speed limiting using low depth returns in the robot frame."""
+
+import math
+
+import numpy as np
+
+from depth_corridor import CORRIDOR_RADIUS_M, fresh_sample
+from motion_safety import clearance_speed_scale
+
+
+DEPTH_VELOCITY_MODES = ('off', 'observe', 'limit')
+DEPTH_STOP_M = 0.42
+DEPTH_SLOW_M = 0.72
+CONFIRM_GAP_S = 0.30
+CONFIRM_CHANGE_M = 0.15
+SUPPORT_SPREAD_M = 0.08
+
+
+def supported_clearance(points):
+    """Return the closest group of three low hits within the forward footprint."""
+    if not len(points):
+        return None
+    forward, lateral = points.T
+    distances = np.sort(forward[(forward > 0) & (np.abs(lateral) <= CORRIDOR_RADIUS_M)])
+    groups = np.flatnonzero(distances[2:] - distances[:-2] <= SUPPORT_SPREAD_M)
+    return float(distances[groups[0]]) if len(groups) else None
+
+
+class DepthVelocityLimiter:
+    def __init__(self):
+        self._history = ()
+
+    def observe(self, stamp, points):
+        history = self._history
+        previous, confirmed = history[-1] if history else (None, None)
+        if not math.isfinite(stamp) or stamp <= 0 or (previous is not None and stamp <= previous[0]):
+            return
+        clearance = supported_clearance(points)
+        if previous is not None and stamp - previous[0] <= CONFIRM_GAP_S:
+            if clearance is None and previous[1] is None:
+                confirmed = None
+            elif (clearance is not None and previous[1] is not None
+                  and abs(clearance - previous[1]) <= CONFIRM_CHANGE_M):
+                confirmed = (stamp, clearance)
+        self._history = (*history[-3:], ((stamp, clearance), confirmed))
+
+    def scale(self, now):
+        latest, confirmed = next(((frame, hit) for frame, hit in reversed(self._history)
+                                  if frame[0] <= now), (None, None))
+        fresh = fresh_sample(latest, now)
+        hit = fresh_sample(confirmed, now)
+        if not fresh or hit is None:
+            return 1.0, fresh, None
+        return clearance_speed_scale(hit[1], DEPTH_STOP_M, DEPTH_SLOW_M), fresh, hit
