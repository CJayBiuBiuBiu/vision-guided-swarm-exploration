index 0000000..50868e1
--- /dev/null
+++ b/turtlebot_ddpg/tests/test_depth_velocity.py
@@ -0,0 +1,43 @@
+import sys
+import unittest
+from pathlib import Path
+
+import numpy as np
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'scripts/voronoi_exploration'))
+from depth_velocity import DepthVelocityLimiter, supported_clearance
+
+
+class DepthVelocityTests(unittest.TestCase):
+    def test_rejects_side_returns_and_requires_a_nearby_group(self):
+        points = np.array([(0.25, 0.23), (0.33, 0.0), (0.55, 0.0),
+                           (0.58, 0.01), (0.59, -0.02)])
+        self.assertAlmostEqual(supported_clearance(points), 0.55)
+        self.assertIsNone(supported_clearance(points[:3]))
+
+    def test_requires_distinct_fresh_consistent_frames(self):
+        limiter = DepthVelocityLimiter()
+        hit = np.array([(0.40, 0.0), (0.41, 0.0), (0.42, 0.0)])
+        limiter.observe(1.0, hit)
+        limiter.observe(1.0, hit)
+        self.assertEqual(limiter.scale(1.12)[0], 1.0)
+        limiter.observe(1.125, hit)
+        self.assertEqual(limiter.scale(1.13)[0], 0.0)
+        self.assertEqual(limiter.scale(1.10)[0], 1.0)
+        limiter.observe(1.255, np.empty((0, 2)))
+        self.assertEqual(limiter.scale(1.24)[1][0], 1.125)
+        self.assertEqual(limiter.scale(1.67), (1.0, None, None))
+        limiter.observe(1.7, hit)
+        self.assertEqual(limiter.scale(1.7)[0], 1.0)
+
+    def test_two_clear_frames_release_the_limit(self):
